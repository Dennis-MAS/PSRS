NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/psrs
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/psrs_test
SESSION_SECRET=replace-with-a-long-random-string
SESSION_MAX_AGE_HOURS=8
TRUST_PROXY=false
SEED_ADMIN_PASSWORD=ChangeMe#2026

# ---- Email through Brevo's HTTP API (not SMTP). Leave blank to run without email. ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PSRS
# Public address of the site, used in email links (required in production), e.g. https://psrs.example.com
APP_URL=http://localhost:3000
